import pygame
import time
pygame.init()
width, height = 800, 600
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("Game Loading Screen")
LACK = (0, 0, 0)
WHITE = (255, 255, 255)
font = pygame.font.Font(None, 36)


def show_loading_screen(controls):
    screen.fill(BLACK)

    title = font.render("Loading...", True, WHITE)
    screen.blit(title, (width // 2 - title.get_width() // 2, 50))

    y_offset = 150
    for action, key in controls.items():
        text = font.render("{action}: {key}", True, WHITE)
        screen.blit(text, (width // 2 - text.get_width() // 2, y_offset))
        y_offset += 50
    game_controls = {
        "Move Left": "Left Arrow",
        "Move Right": "Right Arrow",
        "Jump": "Spacebar",
        "Attack": "X"
    }

    show_loading_screen(game_controls)

    # Simulate loading time
    time.sleep(3)

    # Your game code would start here
    # ...

    pygame.quit()
    pygame.display.flip()
